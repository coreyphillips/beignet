{
  "compilerOptions": {
    "module": "commonjs",
    "esModuleInterop": true,
    "target": "es2020",
    "moduleResolution": "node",
    "sourceMap": true,
    "declarationDir": "./dist/types",
    "outDir": "./dist",
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": false,
    "resolveJsonModule": true,
    "declaration": true,
    "strict": true,
    "allowJs": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "typeRoots": ["./node_modules/@types", "./types"],
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "useUnknownInCatchVariables": false
  },
  // ts-node compiles per file through its LanguageService, which cost ~11 s of
  // every mocha run and would be paid again by each parallel worker. Types are
  // not lost: type-check.yml runs tsc:check and tsc:check:tests on the same
  // events, and lint-check.yml runs type-aware eslint rules. Restore checking
  // for a single run with TS_NODE_TYPE_CHECK=1.
  "ts-node": {
    "transpileOnly": true
  },
  "lib": ["es2020"],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": ["./tests/", "node_modules", "./dist/"]
}
