{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    // node10 resolution has no package self-reference, so the examples' imports
    // of the public entry points are type-checked against the sources they are
    // built from. At runtime Node resolves them through `exports` to dist/.
    "paths": {
      "beignet": ["./src/index.ts"],
      "beignet/cli": ["./src/cli/index.ts"],
      "beignet/lightning": ["./src/lightning/index.ts"],
      "beignet/direct-funding": ["./src/direct-funding/index.ts"],
      "beignet/direct-funding/node": ["./src/direct-funding/node.ts"],
      "beignet/lightning/sqlite": ["./src/lightning/sqlite.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "example/**/*.ts",
    "scripts/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "./dist/"]
}
